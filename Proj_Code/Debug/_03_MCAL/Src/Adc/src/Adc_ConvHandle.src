; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3451  /*******************************************************************************
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3452  **                            General Notes                                   **
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3453  *******************************************************************************/
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3454  /*
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3455  Notification prototype for the notification callback function. It has to
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3456  be implemented by the user.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3457  
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3458  When the notification mechanism is disabled, no notification
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3459  shall be sent. When the notifications are re-enabled again,
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3460  the user will not be notified of events that occurred while
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3461  notifications have been disabled.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3462  
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3463  The ADC Driver shall allow the assignment of identical channels to
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3464  more than one group. However parallel operation of groups with same
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3465  channel are not allowed.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3466  
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3467  All channels of a group share the same configuration related to group.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3468  
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3469  The symbolic names of ADC channels and ADC channel groups for use by
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3470  the upper layer shall be defined by the configurator. They are not
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3471  published by the ADC driver.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3472  
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3473  There are no registers related to ADC that can be written only one time.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3474  
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3475  The callback functions are running in the interrupt context. It's the
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3476  responsibility of the user to keep the code short inside this function.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3477  This is note for the user of ADC driver.
; ..\_03_MCAL\Src\Adc\src\Adc_ConvHandle.c	  3478  */

