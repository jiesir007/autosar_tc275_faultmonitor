; ..\_03_MCAL\Src\Adc\src\Adc.c	  3911  /*
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3912  Notification prototype for the notification callback function. It has to
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3913  be implemented by the user.
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3914  
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3915  When the notification mechanism is disabled, no notification
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3916  shall be sent. When the notifications are re-enabled again, 
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3917  the user will not be notified of events that occurred while 
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3918  notifications have been disabled.
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3919  
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3920  The ADC Driver shall allow the assignment of identical channels to
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3921  more than one group. However parallel operation of groups with same 
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3922  channel are not allowed. 
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3923  
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3924  All channels of a group share the same configuration related to group.
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3925  
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3926  There are no registers related to ADC that can be written only one time.
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3927  
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3928  The callback functions are running in the interrupt context. It's the 
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3929  responsibility of the user to keep the code short inside this function.
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3930  This is note for the user of ADC driver.
; ..\_03_MCAL\Src\Adc\src\Adc.c	  3931  */

