; ..\_01_BSW\Src\Crc\Crc.c	    14   *         \file  Crc.c
; ..\_01_BSW\Src\Crc\Crc.c	    15   *        \brief  Cyclic redundancy check header file
; ..\_01_BSW\Src\Crc\Crc.c	    16   *
; ..\_01_BSW\Src\Crc\Crc.c	    17   *      \details  Crc module is used to calculate cyclic codes, which encode messages by adding a fixed-length check
; ..\_01_BSW\Src\Crc\Crc.c	    18   *                value, for the purpose of error detection. Data blocks get a short CRC value attached, which is
; ..\_01_BSW\Src\Crc\Crc.c	    19   *                based on the remainder of a polynomial division of their contents. Upon retrieval of block data,
; ..\_01_BSW\Src\Crc\Crc.c	    20   *                the calculation is repeated and the calculated value is compared to the attached CRC value in order
; ..\_01_BSW\Src\Crc\Crc.c	    21   *                to ensure data integrity.
; ..\_01_BSW\Src\Crc\Crc.c	    22   *
; ..\_01_BSW\Src\Crc\Crc.c	    23   *********************************************************************************************************************/
; ..\_01_BSW\Src\Crc\Crc.c	    24  
; ..\_01_BSW\Src\Crc\Crc.c	    25  /**********************************************************************************************************************
; ..\_01_BSW\Src\Crc\Crc.c	    26   *  INCLUDES
; ..\_01_BSW\Src\Crc\Crc.c	    27   *********************************************************************************************************************/
