; ..\_01_BSW\Src\Crc\Crc.c	    56  #define CRC_INITIAL_VALUE8H2F       (0xFFu)
; ..\_01_BSW\Src\Crc\Crc.c	    57  #define CRC_POLYNOMIAL_8H2F         (0x2Fu)
; ..\_01_BSW\Src\Crc\Crc.c	    58  #define CRC_FINAL_XOR_CRC8H2F       (0xFFu)
; ..\_01_BSW\Src\Crc\Crc.c	    59  
; ..\_01_BSW\Src\Crc\Crc.c	    60  /* CRC16 polynomial */
