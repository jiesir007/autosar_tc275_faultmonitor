; ..\_01_BSW\Src\Can\Can.c	  8453  /* Justification for module-specific MISRA deviations:
; ..\_01_BSW\Src\Can\Can.c	  8454  
; ..\_01_BSW\Src\Can\Can.c	  8455  MD_Can_Goto:
; ..\_01_BSW\Src\Can\Can.c	  8456  PRQA message 2001
; ..\_01_BSW\Src\Can\Can.c	  8457    Reason: 'goto' statements are used to reduce code complexity.
; ..\_01_BSW\Src\Can\Can.c	  8458    Risk: Incorrect jump.
; ..\_01_BSW\Src\Can\Can.c	  8459    Prevention: Code inspection and runtime tests.
; ..\_01_BSW\Src\Can\Can.c	  8460  
; ..\_01_BSW\Src\Can\Can.c	  8461  MD_Can_MultipleReturn:
; ..\_01_BSW\Src\Can\Can.c	  8462  PRQA message 2889
; ..\_01_BSW\Src\Can\Can.c	  8463    Reason: Multiple return paths are used to reduce code complexity.
; ..\_01_BSW\Src\Can\Can.c	  8464    Risk: Return a function too soon.
; ..\_01_BSW\Src\Can\Can.c	  8465    Prevention: Code inspection and runtime tests.
; ..\_01_BSW\Src\Can\Can.c	  8466  
; ..\_01_BSW\Src\Can\Can.c	  8467  MD_Can_ParameterName:
; ..\_01_BSW\Src\Can\Can.c	  8468  PRQA message 0784
; ..\_01_BSW\Src\Can\Can.c	  8469    Reason: API parameter that is also used as a macro name is accepted for compatibility reasons.
; ..\_01_BSW\Src\Can\Can.c	  8470    Risk: The macro can change the declaration unintentionally.
; ..\_01_BSW\Src\Can\Can.c	  8471    Prevention: Relevant inconsistencies in function declarations, definitions and calls are detected by the compiler.
; ..\_01_BSW\Src\Can\Can.c	  8472  
; ..\_01_BSW\Src\Can\Can.c	  8473  MD_Can_ConstValue:
; ..\_01_BSW\Src\Can\Can.c	  8474  PRQA message 2741, 2742, 2880, 2985, 2986, 2990, 2991, 2992, 2993, 2994, 2995, 2996
; ..\_01_BSW\Src\Can\Can.c	  8475    Reason: Value is constant depending on configuration aspects or platform specific implementation. This leads to constant control expressions, unreachable code or redundant operations.
; ..\_01_BSW\Src\Can\Can.c	  8476    Risk: Wrong or missing functionality.
; ..\_01_BSW\Src\Can\Can.c	  8477    Prevention: Code inspection and test of the different variants in the component test.
; ..\_01_BSW\Src\Can\Can.c	  8478  
; ..\_01_BSW\Src\Can\Can.c	  8479  MD_Can_EmptyFunction:
; ..\_01_BSW\Src\Can\Can.c	  8480  PRQA message 2987
; ..\_01_BSW\Src\Can\Can.c	  8481    Reason: Function is empty depending on configuration aspects and platform specific implementation.
; ..\_01_BSW\Src\Can\Can.c	  8482    Risk: Function implementation missing.
; ..\_01_BSW\Src\Can\Can.c	  8483    Prevention: Code inspection and test of the different variants in the component test.
; ..\_01_BSW\Src\Can\Can.c	  8484  
; ..\_01_BSW\Src\Can\Can.c	  8485  MD_Can_NoneConstParameterPointer:
; ..\_01_BSW\Src\Can\Can.c	  8486  PRQA message 3673
; ..\_01_BSW\Src\Can\Can.c	  8487    Reason: Non-const pointer parameter is required by the internal interface or compatibility reasons but depending on the configuration or specific platform implementation the target may not always be modified.
; ..\_01_BSW\Src\Can\Can.c	  8488    Risk: Read only data could be modified without intention.
; ..\_01_BSW\Src\Can\Can.c	  8489    Prevention: Code inspection and test of the different variants in the component test.
; ..\_01_BSW\Src\Can\Can.c	  8490  
; ..\_01_BSW\Src\Can\Can.c	  8491  MD_Can_ModuleDefine:
; ..\_01_BSW\Src\Can\Can.c	  8492  PRQA message 0602, 0603
; ..\_01_BSW\Src\Can\Can.c	  8493    Reason: Usage of reserved identifiers with leading underscores is accepted for compatibility reasons.
; ..\_01_BSW\Src\Can\Can.c	  8494    Risk: Name conflicts.
; ..\_01_BSW\Src\Can\Can.c	  8495    Prevention: Compile and link of the different variants in the component and integration test.
; ..\_01_BSW\Src\Can\Can.c	  8496  
; ..\_01_BSW\Src\Can\Can.c	  8497  MD_Can_RedundantInit:
; ..\_01_BSW\Src\Can\Can.c	  8498  PRQA message 2981
; ..\_01_BSW\Src\Can\Can.c	  8499    Reason: Reduce code complexity by using an explicit variable initializer that may be always modified before being used in some configurations.
; ..\_01_BSW\Src\Can\Can.c	  8500    Risk: Unintended change of value.
; ..\_01_BSW\Src\Can\Can.c	  8501    Prevention: Code inspection and test of the different variants in the component test.
; ..\_01_BSW\Src\Can\Can.c	  8502  
; ..\_01_BSW\Src\Can\Can.c	  8503  MD_Can_GlobalScope:
; ..\_01_BSW\Src\Can\Can.c	  8504  PRQA message 3218
; ..\_01_BSW\Src\Can\Can.c	  8505    Reason: The usage of variables depends on configuration aspects and they may be used only once or defined globally to improve overview.
; ..\_01_BSW\Src\Can\Can.c	  8506    Risk: None.
; ..\_01_BSW\Src\Can\Can.c	  8507    Prevention: None.
; ..\_01_BSW\Src\Can\Can.c	  8508  
; ..\_01_BSW\Src\Can\Can.c	  8509  MD_Can_ExternalScope:
; ..\_01_BSW\Src\Can\Can.c	  8510  PRQA message 1514, 3408, 3447, 3451, 3210
; ..\_01_BSW\Src\Can\Can.c	  8511    Reason: The variable is used by other modules and can't be declared static.
; ..\_01_BSW\Src\Can\Can.c	  8512    Risk: Name conflicts.
; ..\_01_BSW\Src\Can\Can.c	  8513    Prevention: Compile and link of the different variants in the component and integration test.
; ..\_01_BSW\Src\Can\Can.c	  8514  
; ..\_01_BSW\Src\Can\Can.c	  8515  MD_Can_GenData:
; ..\_01_BSW\Src\Can\Can.c	  8516  PRQA message 1533
; ..\_01_BSW\Src\Can\Can.c	  8517    Reason: These constants are defined in a generated file and cannot be moved to the static source file.
; ..\_01_BSW\Src\Can\Can.c	  8518    Risk: None.
; ..\_01_BSW\Src\Can\Can.c	  8519    Prevention: None.
; ..\_01_BSW\Src\Can\Can.c	  8520  
; ..\_01_BSW\Src\Can\Can.c	  8521  MD_Can_Union:
; ..\_01_BSW\Src\Can\Can.c	  8522  PRQA message 0750, 0759
; ..\_01_BSW\Src\Can\Can.c	  8523    Reason: Using union type to handle different data accesses.
; ..\_01_BSW\Src\Can\Can.c	  8524    Risk: Misinterpreted data.
; ..\_01_BSW\Src\Can\Can.c	  8525    Prevention: Code inspection and test of the different variants in the component test.
