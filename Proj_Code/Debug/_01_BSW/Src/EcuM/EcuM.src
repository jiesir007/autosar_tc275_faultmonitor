; ..\_01_BSW\Src\EcuM\EcuM.c	    14  /**        \file  EcuM.c
; ..\_01_BSW\Src\EcuM\EcuM.c	    15   *        \brief  MICROSAR ECU State Manager
; ..\_01_BSW\Src\EcuM\EcuM.c	    16   *
; ..\_01_BSW\Src\EcuM\EcuM.c	    17   *      \details  The ECU State Manager is responsible for
; ..\_01_BSW\Src\EcuM\EcuM.c	    18   *                  - initialization of some BSW Modules which are needed to start the OS
; ..\_01_BSW\Src\EcuM\EcuM.c	    19   *                  - configuration of the entire ECU for sleep mode
; ..\_01_BSW\Src\EcuM\EcuM.c	    20   *                  - fast and systematic wakeup behavior
; ..\_01_BSW\Src\EcuM\EcuM.c	    21   *                  - shutdown of the ECU
; ..\_01_BSW\Src\EcuM\EcuM.c	    22   *
; ..\_01_BSW\Src\EcuM\EcuM.c	    23   *                To be very independent of different system designs e.g. different Modules to initialize,
; ..\_01_BSW\Src\EcuM\EcuM.c	    24   *                external/internal Watchdog, etc., the ECU State Manager provides over a mechanism named "callouts"
; ..\_01_BSW\Src\EcuM\EcuM.c	    25   *                a way to adapt the startup and shutdown behavior. The system designer must fill the proper code into
; ..\_01_BSW\Src\EcuM\EcuM.c	    26   *                the callouts.
; ..\_01_BSW\Src\EcuM\EcuM.c	    27   *********************************************************************************************************************/
; ..\_01_BSW\Src\EcuM\EcuM.c	    28  
; ..\_01_BSW\Src\EcuM\EcuM.c	    29  /**********************************************************************************************************************
