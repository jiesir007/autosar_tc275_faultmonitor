; ..\_01_BSW\Src\EcuM\EcuM.c	  5230  
; ..\_01_BSW\Src\EcuM\EcuM.c	  5231      /* Get the AlarmClock Id of this User */
; ..\_01_BSW\Src\EcuM\EcuM.c	  5232      AlarmClockUser = EcuM_GetAlarmClockIdOfFlexUser(user);
; ..\_01_BSW\Src\EcuM\EcuM.c	  5233  
; ..\_01_BSW\Src\EcuM\EcuM.c	  5234      /* #21 Check that no earlier alarm is already active. */
; ..\_01_BSW\Src\EcuM\EcuM.c	  5235      if ((EcuM_GetAlarmClockTimeOut(AlarmClockUser) <= sec)
; ..\_01_BSW\Src\EcuM\EcuM.c	  5236          && (EcuM_GetAlarmClockTimeOut(AlarmClockUser) != 0u))
; ..\_01_BSW\Src\EcuM\EcuM.c	  5237      {
; ..\_01_BSW\Src\EcuM\EcuM.c	  5238        retval = E_EARLIER_ACTIVE;
; ..\_01_BSW\Src\EcuM\EcuM.c	  5239      }
; ..\_01_BSW\Src\EcuM\EcuM.c	  5240  
; ..\_01_BSW\Src\EcuM\EcuM.c	  5241      /* #22 Check that that the new alarm is in the future. */
; ..\_01_BSW\Src\EcuM\EcuM.c	  5242      else if (sec <= EcuM_Clock)
; ..\_01_BSW\Src\EcuM\EcuM.c	  5243      {
; ..\_01_BSW\Src\EcuM\EcuM.c	  5244        retval = E_PAST;
; ..\_01_BSW\Src\EcuM\EcuM.c	  5245      }
; ..\_01_BSW\Src\EcuM\EcuM.c	  5246  
