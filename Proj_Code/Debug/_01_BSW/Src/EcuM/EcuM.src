; ..\_01_BSW\Src\EcuM\EcuM.c	  5213  FUNC(Std_ReturnType, ECUM_CODE) EcuM_SetAbsWakeupAlarm(VAR(EcuM_UserType, AUTOMATIC) user,
; ..\_01_BSW\Src\EcuM\EcuM.c	  5214      VAR(EcuM_TimeType, AUTOMATIC) sec)
; ..\_01_BSW\Src\EcuM\EcuM.c	  5215  {
; ..\_01_BSW\Src\EcuM\EcuM.c	  5216    /* ----- Local Variables ---------------------------------------------- */
; ..\_01_BSW\Src\EcuM\EcuM.c	  5217    Std_ReturnType retval = E_NOT_OK;
; ..\_01_BSW\Src\EcuM\EcuM.c	  5218    uint8 errorId = ECUM_E_NO_ERROR;
; ..\_01_BSW\Src\EcuM\EcuM.c	  5219    uint8 AlarmClockUser;
; ..\_01_BSW\Src\EcuM\EcuM.c	  5220  
; ..\_01_BSW\Src\EcuM\EcuM.c	  5221    /* ----- Development Error Checks ------------------------------------- */
; ..\_01_BSW\Src\EcuM\EcuM.c	  5222    /* #20 Check if the calling user is in the range of valid users. */
; ..\_01_BSW\Src\EcuM\EcuM.c	  5223    if ((user >= EcuM_GetSizeOfFlexUser()) || (EcuM_GetAlarmClockIdOfFlexUser(user) == 0xFFu))
; ..\_01_BSW\Src\EcuM\EcuM.c	  5224    {
; ..\_01_BSW\Src\EcuM\EcuM.c	  5225      errorId = ECUM_E_INVALID_PAR;
