; ..\_01_BSW\Src\E2E\E2E_SM.c	    14   *         \file  E2E_SM.c
; ..\_01_BSW\Src\E2E\E2E_SM.c	    15   *        \brief  E2E source file for AUTOSAR E2E State Machine
; ..\_01_BSW\Src\E2E\E2E_SM.c	    16   *
; ..\_01_BSW\Src\E2E\E2E_SM.c	    17   *      \details  E2E protection ensures data exchange which is protected at runtime against the effects of faults within
; ..\_01_BSW\Src\E2E\E2E_SM.c	    18   *                the communication link. E2E Library provides mechanisms for E2E protection, adequate for safety-related
; ..\_01_BSW\Src\E2E\E2E_SM.c	    19   *                communication having requirements up to ASIL D. The E2E Profile check()-functions verify data in one cycle.
; ..\_01_BSW\Src\E2E\E2E_SM.c	    20   *                In contrary, the state machine builds up a state out of several results of check() function within a
; ..\_01_BSW\Src\E2E\E2E_SM.c	    21   *                reception window, which is then provided to the consumer (RTE/SWC/COM).
; ..\_01_BSW\Src\E2E\E2E_SM.c	    22   *
; ..\_01_BSW\Src\E2E\E2E_SM.c	    23   *********************************************************************************************************************/
