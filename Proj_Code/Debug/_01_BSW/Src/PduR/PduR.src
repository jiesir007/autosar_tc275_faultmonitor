; ..\_01_BSW\Src\PduR\PduR.c	  2390      \ACCEPT X
; ..\_01_BSW\Src\PduR\PduR.c	  2391      \REASON Condition can't be covered in configurations with only cross-core routing paths.
; ..\_01_BSW\Src\PduR\PduR.c	  2392  
