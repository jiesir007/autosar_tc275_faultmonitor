; ..\_01_BSW\Src\CanTp\CanTp.c	  1555        /* the padded length is ... */
; ..\_01_BSW\Src\CanTp\CanTp.c	  1556        if (CurrentLength <= 24u)
; ..\_01_BSW\Src\CanTp\CanTp.c	  1557        {
; ..\_01_BSW\Src\CanTp\CanTp.c	  1558          /* ... calculated by masking out the 2 lowest bits (0xFC) and incrementing bit 3 (0x04) */
