; ..\_01_BSW\Src\CanTp\CanTp.c	  7017    \DESCRIPTION    Write access to SduDataPtr, either with constant or calculated index. The pointer itself is
; ..\_01_BSW\Src\CanTp\CanTp.c	  7018                    initialized at the beginning of CanTp_RxFrame to the local array lFCBuffer with size
; ..\_01_BSW\Src\CanTp\CanTp.c	  7019                    CANTP_FRAME_FC_MAX_LENGTH, which is at least 4. The max offset for write accesses to SduDataPtr
; ..\_01_BSW\Src\CanTp\CanTp.c	  7020                    is (SduLength + CANTP_FRAME_OFFSET_FC_STMIN). SduLength can here be 0 or 1,
; ..\_01_BSW\Src\CanTp\CanTp.c	  7021                    CANTP_FRAME_OFFSET_FC_STMIN is 2 --> sum is always below array size
; ..\_01_BSW\Src\CanTp\CanTp.c	  7022    \COUNTERMEASURE \N -
; ..\_01_BSW\Src\CanTp\CanTp.c	  7023  
; ..\_01_BSW\Src\CanTp\CanTp.c	  7024  \ID SBSW_CANTP_TXTRANSMITFRAME_WRITE_SDUDATAPTR
; ..\_01_BSW\Src\CanTp\CanTp.c	  7025    \DESCRIPTION    Write access to SduDataPtr, either with constant or calculated index. The pointer is also used in
; ..\_01_BSW\Src\CanTp\CanTp.c	  7026                    different function calls.
; ..\_01_BSW\Src\CanTp\CanTp.c	  7027                    - the pointer itself is initialized at the beginning of CanTp_TxTransmitFrame to the local array
; ..\_01_BSW\Src\CanTp\CanTp.c	  7028                      lTxFrameDataBuffer with size CANTP_MAX_FRAME_LENGTH.
; ..\_01_BSW\Src\CanTp\CanTp.c	  7029                    - the max pointer offset for write accesses and usage with MemCopy is
; ..\_01_BSW\Src\CanTp\CanTp.c	  7030                      (PCIOffset + AddressOffset + MaxPayloadLength), which have to be less than CANTP_MAX_FRAME_LENGTH.
; ..\_01_BSW\Src\CanTp\CanTp.c	  7031                      --> PCIOffset depends on the frame type.
; ..\_01_BSW\Src\CanTp\CanTp.c	  7032                      --> AddressOffset depends on the Addressing offset
; ..\_01_BSW\Src\CanTp\CanTp.c	  7033                      --> MaxPayloadLength is read from config by CanTp_TxCfg_GetMaxPayload
; ..\_01_BSW\Src\CanTp\CanTp.c	  7034                      FrameType | PCIOffset | AddressOffset | PayloadLength        ||                 Requirement
; ..\_01_BSW\Src\CanTp\CanTp.c	  7035                      ----------+-----------+---------------+----------------------++-----------------------------------------------
; ..\_01_BSW\Src\CanTp\CanTp.c	  7036                      .. SF ... | ... 1 ... | 0 (std) ..... | MaxPayloadLength ... || (MaxPayloadLength + 1) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7037                      .. SF ... | ... 1 ... | 1 (ext / mix) | MaxPayloadLength ... || (MaxPayloadLength + 2) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7038                      .. LSF... | ... 2 ... | 0 (std) ..... | MaxPayloadLength - 1 || (MaxPayloadLength + 1) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7039                      .. LSF... | ... 2 ... | 1 (ext / mix) | MaxPayloadLength - 1 || (MaxPayloadLength + 2) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7040                      .. FF.... | ... 2 ... | 0 (std) ..... | MaxPayloadLength - 1 || (MaxPayloadLength + 1) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7041                      .. FF.... | ... 2 ... | 1 (ext / mix) | MaxPayloadLength - 1 || (MaxPayloadLength + 2) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7042                      .. LFF... | ... 6 ... | 0 (std) ..... | MaxPayloadLength - 5 || (MaxPayloadLength + 1) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7043                      .. LFF... | ... 6 ... | 1 (ext / mix) | MaxPayloadLength - 5 || (MaxPayloadLength + 2) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7044                      .. CF.... | ... 1 ... | 0 (std) ..... | MaxPayloadLength ... || (MaxPayloadLength + 1) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7045                      .. CF.... | ... 1 ... | 1 (ext / mix) | MaxPayloadLength ... || (MaxPayloadLength + 2) <= CANTP_MAX_FRAME_LENGTH
; ..\_01_BSW\Src\CanTp\CanTp.c	  7046    \COUNTERMEASURE \R [CM_CANTP_TXMAXFRAMELENGTH]
