; ..\_01_BSW\Src\CanTp\CanTp.c	  6799  
; ..\_01_BSW\Src\CanTp\CanTp.c	  6800  \ID SBSW_CANTP_TASK_CALL_RXSTATE
; ..\_01_BSW\Src\CanTp\CanTp.c	  6801    \DESCRIPTION    In CanTp_MainFunctionRx, the pTpRxState pointer is used as function parameter to other internal functions.
; ..\_01_BSW\Src\CanTp\CanTp.c	  6802                    The pointer is initialized before (see [SBSW_CANTP_TASK_WRITE_RXSTATE]), and it is ensured that the
; ..\_01_BSW\Src\CanTp\CanTp.c	  6803                    state is initialized (RxHdl != invalid).
; ..\_01_BSW\Src\CanTp\CanTp.c	  6804    \COUNTERMEASURE \N -
; ..\_01_BSW\Src\CanTp\CanTp.c	  6805  
; ..\_01_BSW\Src\CanTp\CanTp.c	  6806  \ID SBSW_CANTP_TASK_WRITE_TXSTATE
