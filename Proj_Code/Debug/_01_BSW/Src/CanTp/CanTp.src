; ..\_01_BSW\Src\CanTp\CanTp.c	  6909                    is < CanTp_Cfg_GetNumTxHdls.
; ..\_01_BSW\Src\CanTp\CanTp.c	  6910                    Since CanTp_Cfg_GetNumTxHdls is mapped to CanTp_GetSizeOfTxSduCfg in CanTp_Priv.h, the CanTp_TxChannelMap
; ..\_01_BSW\Src\CanTp\CanTp.c	  6911                    array must have the same size as CanTp_TxSduCfg.
