; ..\_01_BSW\Src\CanTp\CanTp.c	  1569        }
; ..\_01_BSW\Src\CanTp\CanTp.c	  1570      }
; ..\_01_BSW\Src\CanTp\CanTp.c	  1571      /* else: invalid configuration; DLC > 8 only allowed for N-PDUs which are configured as CAN FD! */
; ..\_01_BSW\Src\CanTp\CanTp.c	  1572    }
