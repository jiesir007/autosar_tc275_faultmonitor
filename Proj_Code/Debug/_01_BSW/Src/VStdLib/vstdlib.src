; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1576   \ID SBSW_VSTDLIB_CALL_UNMODIFIED
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1577     \DESCRIPTION A function is called with unmodified 'pDst' and 'nCnt' parameters.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1578     \COUNTERMEASURE \N The caller of the function ensures that 'pDst' and 'nCnt' are valid. These parameters are passed
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1579                        to the callee without modifications. If the parameters are casted there are no side effects.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1580  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1581   \ID SBSW_VSTDLIB_CALL_MODIFIED_CNT
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1582     \DESCRIPTION A static function is called with unmodified 'pDst' parameter and a modified 'nCnt' parameter.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1583     \COUNTERMEASURE \N The caller of the function ensures that 'pDst' and 'nCnt' are valid. The offset value is
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1584                        always smaller than 4 due to VSTDLIB_ALIGN_OFFSET() and 'nCnt' is 32 or higher at this point.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1585                        Therefore 'pDst' and 'nCnt' for the callee are valid.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1586  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1587   \ID SBSW_VSTDLIB_CALL_MODIFIED_PTR_CNT
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1588     \DESCRIPTION A static function can be called with unmodified or modified 'pDst' and 'nCnt' parameters.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1589     \COUNTERMEASURE \N The caller of the function ensures that 'pDst' and 'nCnt' are valid. In case the function is
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1590                        called with modified parameters (pointer alignment was performed), 'pDst' is incremented by
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1591                        the value of 'nDstOffset' and 'nCnt' is decremented by the same value. Therefore 'pDst'
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1592                        and 'nCnt' for the callee are valid.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1593  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1594   \ID SBSW_VSTDLIB_ACCESS_LOOP
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1595     \DESCRIPTION Linear memory access using a for loop.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1596     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. The for loop ensures that
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1597                        the loop index is always smaller than nCnt. Therefore only valid memory is accessed.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1598  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1599   \ID SBSW_VSTDLIB_ACCESS_8_JUMPTABLE
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1600     \DESCRIPTION Linear 8-bit-access using a switch statement.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1601     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. The constant indices are
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1602                        always smaller than the value of 'nCnt'. Therefore only valid memory is accessed.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1603  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1604   \ID SBSW_VSTDLIB_ACCESS_32_LOOP
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1605     \DESCRIPTION Linear 32-bit-access using a for loop.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1606     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. The access index 'dPos'
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1607                        is initialized with 0. The loop control variable 'remaining' is decremented by 16 per iteration.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1608                        The exit condition ensures that at least 16 bytes are valid per iteration. The access index
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1609                        'dPos' plus constant offset ensures that exactly 16 valid bytes are accessed. 'dPos' is
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1610                        incremented by 4 (that equals 16 bytes) after the access.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1611  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1612   \ID SBSW_VSTDLIB_ACCESS_32_LOOP_REMAINING
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1613     \DESCRIPTION Linear 32-bit-access using a for loop.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1614     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. After the for loop above
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1615                        'remaining' bytes of valid memory start at the address that is indicated by 'dPos'. The loop
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1616                        control variable 'remaining' is decremented by 4 per iteration. The exit condition ensures that
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1617                        at least 4 bytes are valid per iteration. The access index 'dPos' ensures that exactly 4 valid
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1618                        bytes are accessed. 'dPos' is incremented by 1 (that equals 4 bytes) after the access.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1619  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1620   \ID SBSW_VSTDLIB_ACCESS_32_JUMPTABLE
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1621     \DESCRIPTION Linear 32-bit-access using a switch statement.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1622     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. After the for loop above
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1623                        'remaining' bytes of valid memory start at the address that is indicated by 'dPos'. The switch
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1624                        statement ensures that an access is only made if at least 4 byte are valid. 'dPos' is
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1625                        incremented by 4 after the access.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1626  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1627   \ID SBSW_VSTDLIB_CALL_REMAINING_JUMPTABLE
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1628     \DESCRIPTION A static function is called to access the remaining bytes at the end of processing a 32-bit jump table.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1629     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. At this point 0-3
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1630                        bytes of valid memory (indicated by the LSBs of 'remaining') start at the address that is
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1631                        indicated by 'dPos'. Due to the usage of VSTDLIB_MASK_3 'pDst' and 'nCnt' for the callee are
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1632                        valid.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1633  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1634   \ID SBSW_VSTDLIB_CALL_REMAINING
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1635     \DESCRIPTION A static function is called to access the remaining bytes after 32-bit operations.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1636     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. After the for loop above
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1637                        'remaining' bytes of valid memory start at the address that is indicated by 'dPos'. Therefore
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1638                        'pDst' and 'nCnt' for the callee are valid.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1639  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1640   \ID SBSW_VSTDLIB_CALL_REMAINING_PARTIAL
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1641     \DESCRIPTION A static function is called to access the remaining partial word after 32-bit displacement operations.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1642     \COUNTERMEASURE \N The caller of this function ensures that 'pDst' and 'nCnt' are valid. At this point at least
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1643                        (4 - 'nDstOffset') bytes of valid memory start at the address that is indicated by 'dPos'.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1644                        Therefore 'pDst' and 'nCnt' for the callee are valid.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1645  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1646   \ID SBSW_VSTDLIB_ACCESS_LOCAL
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1647     \DESCRIPTION Access to a pointer referencing a local variable.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1648     \COUNTERMEASURE \N The static function VStdLib_Loc_MemCpy_8_PartialWord() is only called with valid pointers to
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1649                        local parameters.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1650  
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1651   \ID SBSW_VSTDLIB_ACCESS_VERSIONINFO
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1652     \DESCRIPTION The function VStdLib_GetVersionInfo() writes to the object referenced by parameter 'versioninfo'.
; ..\_01_BSW\Src\VStdLib\vstdlib.c	  1653     \COUNTERMEASURE \N The caller ensures that the pointer passed to the parameter 'versioninfo' is valid and references
