; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   582   \DESCRIPTION    Write access to a Data element. The Data element is derived with an index from a Queue object.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   583                   The Queue is derived from a PriorityQueue which is passed as argument. Precondition ensures that the
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   584                   PriorityQueue pointer is valid. The compliance of the precondition is check during review.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   585   \COUNTERMEASURE \T [CM_OS_PRIORITYQUEUE_QUEUE_DATA_T]
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   586                   \M [CM_OS_PRIORITYQUEUE_QUEUE_DATA_M]
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   587  
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   588  \ID SBSW_OS_PQ_PRIORITYQUEUEGETDYN_001
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   589   \DESCRIPTION    Write access to a Dyn element. The Dyn element is derived from a PriorityQueue which is passed as
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   590                   argument. Precondition ensures that the PriorityQueue pointer is valid. The compliance of the
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   591                   precondition is check during review.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   592   \COUNTERMEASURE \T [CM_OS_PRIORITYQUEUE_QUEUE_DATA_T]
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   593                   \M [CM_OS_PRIORITYQUEUE_DYN_M]
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   594  
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   595  SBSW_JUSTIFICATION_END */
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   596  
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   597  
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   598  /*
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   599  \CM CM_OS_PRIORITYQUEUE_QUEUE_DATA_T
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   600        TCASE-345828 ensures consistent management of Data handled by the priority queue class and that the used indieces
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   601        are in a valid range.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   602  
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   603  \CM CM_OS_PRIORITYQUEUE_QUEUE_DATA_M
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   604        Verify that:
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   605          1. Verify that the Queue pointer of each priority queue is no NULL_PTR and
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   606          2. the size of the Queue is equal QueueSize + 1.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   607          3. Verify that the queue size is sufficient to handle all client data (in case of counters, the queue size
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   608             has to be at least equal to the number of jobs + 1, handled by the counter).
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   609  
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   610  \CM CM_OS_PRIORITYQUEUE_DYN_M
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   611        Verify that the Dyn pointer of each PriorityQueue object is valid.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   612  
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   613  \CM CM_OS_PRIORITYQUEUETOPGET_R
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   614        Implementation ensures that the returned pointer is not used for write access if it is a NULL_PTR.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   615   */
