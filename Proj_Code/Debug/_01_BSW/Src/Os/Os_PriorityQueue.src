; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   574  \ID SBSW_OS_PQ_JOBPRIORITYCOMPARE_001
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   575   \DESCRIPTION    Os_JobPriorityCompare is called with values derived from a Queue. The Queue is part of a
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   576                   PriorityQueue which is passed as argument. Precondition ensures that the PriorityQueue pointer is
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   577                   valid. The compliance of the precondition is check during review.
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   578   \COUNTERMEASURE \T [CM_OS_PRIORITYQUEUE_QUEUE_DATA_T]
; ..\_01_BSW\Src\Os\Os_PriorityQueue.c	   579                   \M [CM_OS_PRIORITYQUEUE_QUEUE_DATA_M]
