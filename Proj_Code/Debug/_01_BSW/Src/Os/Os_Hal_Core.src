; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   322  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   323  \ID SBSW_OS_HAL_PWA_CALLER
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   324   \DESCRIPTION    A write access is performed on a pointer, which is coming directly from the caller.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   325   \COUNTERMEASURE \N No measure is required, because the caller has to check the validity.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   326  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   327  \ID SBSW_OS_HAL_FC_CALLER
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   328   \DESCRIPTION    A function is called with one or more pointer parameters, which are coming directly from the caller.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   329   \COUNTERMEASURE \N No measure is required, because the caller has to check the validity.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   330  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   331  \ID SBSW_OS_HAL_FC_LOCAL_VAR
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   332   \DESCRIPTION    A function is called with one or more pointer parameters, which are pointing to local variables.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   333   \COUNTERMEASURE \N No measure is required, because local variables are always valid.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   334  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   335  \ID SBSW_OS_HAL_FC_MIXED_VAR
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   336   \DESCRIPTION    A function is called with one or more pointer parameters, which are pointing to local variables or
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   337                   are passed to the calling function.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   338   \COUNTERMEASURE \N No measure is required, because local variables are always valid.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   339  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   340  \ID SBSW_OS_HAL_PWA_FIRST_PCXI
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   341   \DESCRIPTION    A write access is performed on a pointer, which points to the memory address of the CSA frame. The
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   342                   memory address is derived from "Context->InitPCXI". The validity of "Context" is ensured by the
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   343                   caller. The content of "Context->InitPCXI" is also valid, because it is always initialized, before
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   344                   this pointer write access is performed. If "Context" is a task context, then its "InitPCXI" is
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   345                   initialized in Os_Hal_ContextInit and is re-initialized in Os_Hal_ContextReset and
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   346                   Os_Hal_ContextResetAndResume. If "Context" is an ISR/Hook context, then its "InitPCXI" is either
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   347                   initialized in Os_Hal_ContextInit or re-initialized in Os_Hal_Abort, when the ISR is killed.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   348                   As a result, whenever Os_Hal_ContextIntCleanupCSAs is called, "Context->InitPCXI" always contains
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   349                   a valid value. Thus, this write access is always performed on a valid pointer.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   350   \COUNTERMEASURE \N No measure is required, because its validity is ensured by code review.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   351  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   352  \ID SBSW_OS_HAL_PWA_PCXI
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   353   \DESCRIPTION    A write access is performed on a pointer, which points to the memory address of the CSA frame. The
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   354                   memory address is derived from the PCXI register. Since Os_Hal_Svlcx is previously performed, the
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   355                   PCXI register always contains a valid value. Thus, this write access is always performed on a valid
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   356                   pointer.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   357   \COUNTERMEASURE \N No measure is required, because its validity is ensured by code review.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   358  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   359  \ID SBSW_OS_HAL_PWA_PCXI_CONTEXTSWITCH
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   360   \DESCRIPTION    A write access is performed on a pointer, which points to the memory address of the CSA frame. The
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   361                   memory address is derived from the InitPCXI or PreviousContextInfo of the context, which is
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   362                   initialized previously by calling Os_Hal_ContextInit in the core code.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   363   \COUNTERMEASURE \N No measure is required, because its validity is ensured by code review.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   364  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   365  \ID SBSW_OS_HAL_PWA_CORECONFIG_PC
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   366   \DESCRIPTION    A write access is performed on the program counter of a foreign core. The address is generated in
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   367                   the corresponding core configuration of type Os_Hal_CoreConfigType.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   368   \COUNTERMEASURE \S Safety manual should state that generated constant variable of Os_Hal_CoreConfigType in
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   369                   Os_Hal_Core_Lcfg.c needs to be checked. More specifically, the attribute ".ProgramCounterRegister"
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   370                   must be OS_HAL_CORE<X>_PC, where <X> is the core ID. SMI-474
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   371  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   372  \ID SBSW_OS_HAL_PWA_CORECONFIG_DBGSR
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   373   \DESCRIPTION    A write access is performed on the DBGSR register of a foreign core. The address is generated in
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   374                   the corresponding core configuration of type Os_Hal_CoreConfigType.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   375   \COUNTERMEASURE \S Safety manual should state that generated constant variable of Os_Hal_CoreConfigType in
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   376                   Os_Hal_Core_Lcfg.c needs to be checked. More specifically, the attribute ".DBGSRRegister"
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   377                   must be OS_HAL_CORE<X>_DBGSR, where <X> is the core ID. SMI-475
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   378  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   379  \ID SBSW_OS_HAL_PWA_CORECONFIG_SYSCON
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   380   \DESCRIPTION    A write access is performed on the SYSCON register of a foreign core. The address is generated in
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   381                   the corresponding core configuration of type Os_Hal_CoreConfigType.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   382   \COUNTERMEASURE \S Safety manual should state that generated constant variable of Os_Hal_CoreConfigType in
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   383                   Os_Hal_Core_Lcfg.c needs to be checked. More specifically, the attribute ".SYSCONRegister"
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   384                   must be OS_HAL_CORE<X>_SYSCON, where <X> is the core ID. SMI-46520
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   385  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   386  \ID SBSW_OS_HAL_PWA_ISRCONFIG_XSIG
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   387   \DESCRIPTION    A write access is performed on the interrupt source register (SRC) of the configured XSignal ISR. The
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   388                   address is in the generated XSignal interrupt configuration of type Os_Hal_XSigInterruptConfigType.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   389                   In addition, the validity of OS_HAL_INT_SRC_BASE is checked by review.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   390   \COUNTERMEASURE \S Safety manual should state that the functionality of each configured ISR has to be checked for its
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   391                   correctness. This includes the correct call of the ISR handler as well as enabling, disabling,
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   392                   reading the enable state, reading the pending state and clearing of the pending information of
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   393                   the corresponding ISR sources. SMI-491
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   394  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   395  \ID SBSW_OS_HAL_PWA_ISRCONFIG
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   396   \DESCRIPTION    A write access is performed on the interrupt source register (SRC) of the configured ISR. The
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   397                   address is in the generated interrupt configuration of type Os_Hal_IntIsrConfigType.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   398                   In addition, the validity of OS_HAL_INT_SRC_BASE is checked by review.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   399   \COUNTERMEASURE \S Safety manual should state that the functionality of each configured ISR has to be checked for its
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   400                   correctness. This includes the correct call of the ISR handler as well as enabling, disabling,
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   401                   reading the enable state, reading the pending state and clearing of the pending information of
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   402                   the corresponding ISR sources. SMI-491
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   403  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   404  \ID SBSW_OS_HAL_FC_MPUCONFIG
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   405   \DESCRIPTION    A function is called with a pointer parameter.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   406   \COUNTERMEASURE \N No measure required, because this pointer will not be used for write operation by the callee.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   407  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   408  \ID SBSW_OS_HAL_PWA_GPTCONFIG
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   409   \DESCRIPTION    A write access is performed on a pointer, which is in the generated timer configuration for GPT of
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   410                   type Os_Hal_TimerPitConfigType.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   411   \COUNTERMEASURE \S Safety manual should state that the PIT timer configuration is to be checked for its correctness.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   412                   More specifically, if the GPT channel 0 is configured, the following attributes must be generated
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   413                   as follows:
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   414                   CounterRegisterAddress      = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_T3_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   415                   CounterConfRegisterAddress  = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_T3CON_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   416                   ReloadRegisterAddress       = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_T2_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   417                   ReloadConfRegisterAddress   = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_T2CON_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   418                   InterruptSRCRegisterAddress = OS_HAL_INT_SRC_BASE + OS_HAL_INT_SRC_GPT_CH0_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   419                   If the GPT channel 1 is configured, the following attributes must be generated as follows:
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   420                   CounterRegisterAddress      = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_T6_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   421                   CounterConfRegisterAddress  = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_T6CON_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   422                   ReloadRegisterAddress       = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_CAPREL_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   423                   ReloadConfRegisterAddress   = OS_HAL_TIMER_GPT_BASE + OS_HAL_TIMER_GPT_CAPREL_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   424                   InterruptSRCRegisterAddress = OS_HAL_INT_SRC_BASE + OS_HAL_INT_SRC_GPT_CH1_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   425                   SMI-478
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   426  
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   427  \ID SBSW_OS_HAL_PWA_FRTCONFIG
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   428   \DESCRIPTION    A write access is performed on a pointer, which is in the generated timer configuration for STM of
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   429                   type Os_Hal_TimerFFrtConfigType.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   430   \COUNTERMEASURE \S Safety manual should state that the PIT timer configuration is to be checked for its correctness.
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   431                   More specifically, the following attributes must generated as follows, where <X> (0, 1, 2, 3, 4, 5)
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   432                   is STM ID and <Y> (0, 1) is the compare channel ID:
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   433                   CompareRegisterAddress      = OS_HAL_TIMER_STM<X>_BASE + OS_HAL_TIMER_STM_CMP<Y>_OFFSET
