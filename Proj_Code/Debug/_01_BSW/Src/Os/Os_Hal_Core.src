; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   435                   InterruptSRCRegisterAddress = OS_HAL_INT_SRC_BASE + OS_HAL_INT_SRC_STM<X>_CH<Y>_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   436                   ICRRegisterAddress          = OS_HAL_TIMER_STM<X>_BASE + OS_HAL_TIMER_STM_ICR_OFFSET
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   437                   SMI-479
; ..\_01_BSW\Src\Os\Os_Hal_Core.c	   438  
