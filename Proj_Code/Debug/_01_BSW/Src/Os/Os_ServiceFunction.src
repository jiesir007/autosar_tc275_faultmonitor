; ..\_01_BSW\Src\Os\Os_TimingProtection.h	  1064  
; ..\_01_BSW\Src\Os\Os_TimingProtection.h	  1065          /* #60 If the remaining time of the previous budget is bigger than the consumed time (likely): */
