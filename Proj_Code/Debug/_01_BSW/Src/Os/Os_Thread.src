; ..\_01_BSW\Src\Os\Os_Trace.h	    72  /*! \brief          Trace thread-switches, where thread stands for task or ISR
; ..\_01_BSW\Src\Os\Os_Trace.h	    73   *  \details        This hook routine allows external tools to trace all context switches from task to ISR and back as
; ..\_01_BSW\Src\Os\Os_Trace.h	    74   *                  well as between tasks and between ISRs. So external tools may visualize the information or measure
; ..\_01_BSW\Src\Os\Os_Trace.h	    75   *                  the execution time of tasks and ISRs.
; ..\_01_BSW\Src\Os\Os_Trace.h	    76   *                  Mind that measured execution time values may not reflect the worst case, which would be necessary
; ..\_01_BSW\Src\Os\Os_Trace.h	    77   *                  for schedulability analysis.
; ..\_01_BSW\Src\Os\Os_Trace.h	    78   *
; ..\_01_BSW\Src\Os\Os_Trace.h	    79   *                  Callers:
; ..\_01_BSW\Src\Os\Os_Trace.h	    80   *                    - Os_TraceThreadSwitch()
; ..\_01_BSW\Src\Os\Os_Trace.h	    81   *                    - Os_TraceThreadResetAndResume()
; ..\_01_BSW\Src\Os\Os_Trace.h	    82   *                    - Os_TraceThreadCleanupAndResume()
; ..\_01_BSW\Src\Os\Os_Trace.h	    83   *                    - Os_TraceThreadSuspendAndStart()
; ..\_01_BSW\Src\Os\Os_Trace.h	    84   *
; ..\_01_BSW\Src\Os\Os_Trace.h	    85   *  \param[in]      FromThreadId     The ID of the thread which has run until the switch
; ..\_01_BSW\Src\Os\Os_Trace.h	    86   *  \param[in]      FromThreadReason Represents the reason why the thread is no longer running:
; ..\_01_BSW\Src\Os\Os_Trace.h	    87   *                                   - \ref OS_VTHP_TASK_TERMINATION
; ..\_01_BSW\Src\Os\Os_Trace.h	    88   *                                   - \ref OS_VTHP_ISR_END
; ..\_01_BSW\Src\Os\Os_Trace.h	    89   *                                   - \ref OS_VTHP_TASK_WAITEVENT
; ..\_01_BSW\Src\Os\Os_Trace.h	    90   *                                   - \ref OS_VTHP_TASK_WAITSEMA
; ..\_01_BSW\Src\Os\Os_Trace.h	    91   *                                   - \ref OS_VTHP_THREAD_PREEMPT
; ..\_01_BSW\Src\Os\Os_Trace.h	    92   *  \param[in]      ToThreadId       The ID of the thread which will run from now on
; ..\_01_BSW\Src\Os\Os_Trace.h	    93   *  \param[in]      ToThreadReason   Represents the reason why the thread runs from now on:
; ..\_01_BSW\Src\Os\Os_Trace.h	    94   *                                   - \ref OS_VTHP_TASK_ACTIVATION
; ..\_01_BSW\Src\Os\Os_Trace.h	    95   *                                   - \ref OS_VTHP_ISR_START
; ..\_01_BSW\Src\Os\Os_Trace.h	    96   *                                   - \ref OS_VTHP_TASK_SETEVENT
; ..\_01_BSW\Src\Os\Os_Trace.h	    97   *                                   - \ref OS_VTHP_TASK_GOTSEMA
; ..\_01_BSW\Src\Os\Os_Trace.h	    98   *                                   - \ref OS_VTHP_THREAD_RESUME
; ..\_01_BSW\Src\Os\Os_Trace.h	    99   *                                   - \ref OS_VTHP_THREAD_CLEANUP
; ..\_01_BSW\Src\Os\Os_Trace.h	   100   *  \param[in]      CallerCoreId     The ID of the core where the thread switch occurs
; ..\_01_BSW\Src\Os\Os_Trace.h	   101   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   102   *  \context        OS internal
; ..\_01_BSW\Src\Os\Os_Trace.h	   103   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   104   *  \reentrant      TRUE for different cores.
; ..\_01_BSW\Src\Os\Os_Trace.h	   105   *  \synchronous    TRUE
; ..\_01_BSW\Src\Os\Os_Trace.h	   106   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   107   *  \pre            Interrupts locked to TP lock level.
; ..\_01_BSW\Src\Os\Os_Trace.h	   108   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   109   **********************************************************************************************************************/
; ..\_01_BSW\Src\Os\Os_Trace.h	   110  # define OS_VTH_SCHEDULE(FromThreadId,FromThreadReason,ToThreadId,ToThreadReason,CallerCoreId) \ 
; ..\_01_BSW\Src\Os\Os_Trace.h	   111     OS_IGNORE_UNREF_PARAM(FromThreadId)     ;            \ 
; ..\_01_BSW\Src\Os\Os_Trace.h	   112     OS_IGNORE_UNREF_PARAM(FromThreadReason) ;            \ 
; ..\_01_BSW\Src\Os\Os_Trace.h	   113     OS_IGNORE_UNREF_PARAM(ToThreadId)       ;            \ 
; ..\_01_BSW\Src\Os\Os_Trace.h	   114     OS_IGNORE_UNREF_PARAM(ToThreadReason)   ;            \ 
; ..\_01_BSW\Src\Os\Os_Trace.h	   115     OS_IGNORE_UNREF_PARAM(CallerCoreId)     ;
; ..\_01_BSW\Src\Os\Os_Trace.h	   116  #endif
; ..\_01_BSW\Src\Os\Os_Trace.h	   117  
; ..\_01_BSW\Src\Os\Os_Trace.h	   118  #ifndef OS_IS_DEFINED_OS_VTH_FORCED_TERMINATION
; ..\_01_BSW\Src\Os\Os_Trace.h	   119  /***********************************************************************************************************************
; ..\_01_BSW\Src\Os\Os_Trace.h	   120   *  OS_VTH_FORCED_TERMINATION()
; ..\_01_BSW\Src\Os\Os_Trace.h	   121   **********************************************************************************************************************/
; ..\_01_BSW\Src\Os\Os_Trace.h	   122  /*! \brief          Trace the forcible termination of a thread (task or ISR)
; ..\_01_BSW\Src\Os\Os_Trace.h	   123   *  \details        This hook routine allows external tools to trace the forcible termination of tasks and ISRs.
; ..\_01_BSW\Src\Os\Os_Trace.h	   124   *                  Forcible termination may take place as a reaction on a detected protection error or as result of
; ..\_01_BSW\Src\Os\Os_Trace.h	   125   *                  a call to the API function TerminateApplication.
; ..\_01_BSW\Src\Os\Os_Trace.h	   126   *                  Mind that forcibly terminated threads change their internal state without further notice. However,
; ..\_01_BSW\Src\Os\Os_Trace.h	   127   *                  in some situations a return to the thread is necessary for OS internal cleanup. In this case the
; ..\_01_BSW\Src\Os\Os_Trace.h	   128   *                  OS_VTH_SCHEDULE macro is called with ToThreadReason OS_VTHP_THREAD_CLEANUP. That cleanup will
; ..\_01_BSW\Src\Os\Os_Trace.h	   129   *                  not return to the application code of the thread but only be operating system internal.
; ..\_01_BSW\Src\Os\Os_Trace.h	   130   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   131   *                  Callers:
; ..\_01_BSW\Src\Os\Os_Trace.h	   132   *                    - Os_TraceIsrKill()
; ..\_01_BSW\Src\Os\Os_Trace.h	   133   *                    - Os_TraceTaskKill()
; ..\_01_BSW\Src\Os\Os_Trace.h	   134   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   135   *  \param[in]      ThreadId      The ID of the thread which is forcibly terminated
; ..\_01_BSW\Src\Os\Os_Trace.h	   136   *  \param[in]      CallerCoreId  The ID of the core where the forcible termination occurs
; ..\_01_BSW\Src\Os\Os_Trace.h	   137   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   138   *  \context        OS internal
; ..\_01_BSW\Src\Os\Os_Trace.h	   139   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   140   *  \reentrant      TRUE for different cores.
; ..\_01_BSW\Src\Os\Os_Trace.h	   141   *  \synchronous    TRUE
; ..\_01_BSW\Src\Os\Os_Trace.h	   142   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   143   *  \pre            Interrupts locked to TP lock level.
; ..\_01_BSW\Src\Os\Os_Trace.h	   144   **********************************************************************************************************************/
; ..\_01_BSW\Src\Os\Os_Trace.h	   145  # define OS_VTH_FORCED_TERMINATION(ThreadId,CallerCoreId) \ 
; ..\_01_BSW\Src\Os\Os_Trace.h	   146     OS_IGNORE_UNREF_PARAM(ThreadId)    ;            \ 
; ..\_01_BSW\Src\Os\Os_Trace.h	   147     OS_IGNORE_UNREF_PARAM(CallerCoreId);
; ..\_01_BSW\Src\Os\Os_Trace.h	   148  #endif
; ..\_01_BSW\Src\Os\Os_Trace.h	   149  
; ..\_01_BSW\Src\Os\Os_Trace.h	   150  #ifndef OS_IS_DEFINED_OS_VTH_ACTIVATION
; ..\_01_BSW\Src\Os\Os_Trace.h	   151  /***********************************************************************************************************************
; ..\_01_BSW\Src\Os\Os_Trace.h	   152   *  OS_VTH_ACTIVATION()
; ..\_01_BSW\Src\Os\Os_Trace.h	   153   **********************************************************************************************************************/
; ..\_01_BSW\Src\Os\Os_Trace.h	   154  /*! \brief          Trace the activation of a task.
; ..\_01_BSW\Src\Os\Os_Trace.h	   155   *  \details        This hook is called on the caller core when that core has successfully performed the activation of
; ..\_01_BSW\Src\Os\Os_Trace.h	   156   *                  TaskId on the destination core. As this OS implementation always performs task activation on the
; ..\_01_BSW\Src\Os\Os_Trace.h	   157   *                  destination core, DestCoreId and CallerCoreId are always identical.
; ..\_01_BSW\Src\Os\Os_Trace.h	   158   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   159   *                  Callers:
; ..\_01_BSW\Src\Os\Os_Trace.h	   160   *                    - Os_TraceTaskActivate()
; ..\_01_BSW\Src\Os\Os_Trace.h	   161   *
; ..\_01_BSW\Src\Os\Os_Trace.h	   162   *  \param[in]      TaskId       The ID of the task which is activated
; ..\_01_BSW\Src\Os\Os_Trace.h	   163   *  \param[in]      DestCoreId   The ID of the core where the task will be executed
; ..\_01_BSW\Src\Os\Os_Trace.h	   164   *  \param[in]      CallerCoreId The ID of the core where this hook is called
; ..\_01_BSW\Src\Os\Os_Trace.h	   165   *
