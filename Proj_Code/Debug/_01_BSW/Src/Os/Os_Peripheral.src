; ..\_01_BSW\Src\Os\Os_Peripheral.c	   835   \DESCRIPTION    Os_ThreadCheckCallContext is called with the return value of Os_CoreGetThread.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   836   \COUNTERMEASURE \N [CM_OS_COREGETTHREAD_N]
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   837  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   838  \ID SBSW_OS_PP_THREADGETCURRENTAPPLICATION_001
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   839   \DESCRIPTION    Os_ThreadGetCurrentApplication is called with the return value of Os_CoreGetThread.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   840   \COUNTERMEASURE \N [CM_OS_COREGETTHREAD_N]
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   841  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   842  \ID SBSW_OS_PP_APPCHECKACCESS_001
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   843   \DESCRIPTION    Os_AppCheckAccess is called with the return value of Os_ThreadGetCurrentApplication.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   844   \COUNTERMEASURE \N [CM_OS_THREADGETCURRENTAPPLICATION_N]
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   845  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   846  \ID SBSW_OS_PP_PERIPHERALCHECKADDRESSRANGE08_001
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   847   \DESCRIPTION    Os_PeripheralCheckAddressRange08 is called with the return value of Os_PeripheralCheck.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   848   \COUNTERMEASURE \N [CM_OS_PERIPHERALCHECK_N]
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   849  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   850  \ID SBSW_OS_PP_PERIPHERALCHECKADDRESSRANGE16_001
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   851   \DESCRIPTION    Os_PeripheralCheckAddressRange16 is called with the return value of Os_PeripheralCheck.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   852   \COUNTERMEASURE \N [CM_OS_PERIPHERALCHECK_N]
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   853  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   854  \ID SBSW_OS_PP_PERIPHERALCHECKADDRESSRANGE32_001
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   855   \DESCRIPTION    Os_PeripheralCheckAddressRange32 is called with the return value of Os_PeripheralCheck.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   856   \COUNTERMEASURE \N [CM_OS_PERIPHERALCHECK_N]
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   857  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   858  \ID SBSW_OS_PP_PERIPHERAL_ADDRESS_001
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   859   \DESCRIPTION    Write access to a address passed as argument.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   860   \COUNTERMEASURE \S [CM_OS_PERIPHERAL_ADDRESS_S]
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   861  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   862  \ID SBSW_OS_PP_PERIPHERALCHECK
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   863   \DESCRIPTION    Pass pointer to validation function.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   864   \COUNTERMEASURE \N Called validation function checks whether Address is in the range of the given Peripheral Region.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   865                      There is no precondition for parameter Address. The validation function does neither write nor read
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   866                      to the given Address.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   867  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   868  SBSW_JUSTIFICATION_END */
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   869  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   870  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   871  /*
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   872  \CM CM_OS_PERIPHERALID2PERIPHERAL
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   873        Verify that:
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   874          1. Verify that each peripheral region in OsCfg_PeripheralRefs is no NULL_PTR,
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   875          2. the size of OsCfg_PeripheralRefs is equal OS_PERIPHERALID_COUNT + 1 and
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   876          3. each element in Os_PeripheralIdType has a value lower than OS_PERIPHERALID_COUNT.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   877  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   878  \CM CM_OS_PERIPHERALCHECK_N
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   879        Precondition ensures that the pointer is valid. The compliance of the precondition is check during review.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   880  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   881  \CM CM_OS_PERIPHERAL_ADDRESS_S
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   882        Verify that the complete range specified by each Os_PeripheralConfigType object in Os_Peripheral_Lcfg.c is either
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   883        part of the writable address space or that there are no write accesses to that region via the Peripheral API.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   884        The first writable address is denoted as AddressStart and the last writable address is denoted as AddressEnd.
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   885        SMI-340
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   886  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   887   */
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   888  
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   889  /*!
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   890   * \}
; ..\_01_BSW\Src\Os\Os_Peripheral.c	   891   */
